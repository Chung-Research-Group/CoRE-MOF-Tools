exclude CoREMOF/_release_checkers_worker.py
exclude CoREMOF/_release_mosaec_worker.py
exclude CoREMOF/_release_setc_protocol.py
exclude CoREMOF/_release_setc_worker.py
include THIRD_PARTY_NOTICES.md
recursive-include licenses *.txt
include ML_BENCHMARK_HANDOFF.md
include ruff.toml
recursive-include CoREMOF/_topology_profile *.jl *.toml
include README_DATASET_SPLITTING.md
recursive-include examples *.py
include examples/README.md
include examples/CoREMOF_dataset_splitting_quickstart.ipynb
include COMBINED_TARGET_DATASET.md
include V2602_COMBINED_TARGET_COVERAGE_20260904.json
include .github/workflows/tests.yml
recursive-include docs/source *.rst
include docs/Makefile
include docs/make.bat
include docs/requirements.txt
include docs/source/conf.py
include docs/source/_static/custom.css
include docs/source/_static/coremof-logo.png
