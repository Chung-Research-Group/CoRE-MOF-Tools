include manuscript/references.bib
include manuscript/verification.json
include manuscript/figures/workflow.svg
include manuscript/figures/workflow.pdf
include manuscript/figures/workflow.png
# Retain the portable benchmark skill, not original-host operational runbooks.
recursive-include .agents/skills/coremof-release-curation *.md
